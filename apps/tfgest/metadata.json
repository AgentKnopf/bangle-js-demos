{
  "id": "tfgest",
  "name": "TF wrist gestures",
  "shortName": "TF gestures",
  "version": "0.01",
  "description": "Record wrist gestures, train a tiny TensorFlow Lite model on a PC and run it on the watch.",
  "icon": "app.png",
  "type": "app",
  "tags": "tool,ml",
  "supports": ["BANGLEJS2"],
  "readme": "README.md",
  "allow_emulator": true,
  "storage": [
    { "name": "tfgest.app.js", "url": "tfgest.app.js" },
    { "name": "tfgest", "url": "tfgest.lib.js" },
    { "name": "tfgest.img", "url": "app-icon.js", "evaluate": true }
  ],
  "data": [
    { "name": ".tfmodel" },
    { "name": "gestmodel.json" },
    { "name": "tfgest.tw.json" },
    { "wildcard": "gest.*" }
  ]
}
